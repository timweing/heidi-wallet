# ============ Frontend (.env / Vercel) ============
# VITE_* landet im Browser-Bundle -> nur oeffentliche Werte.

# Pimlico (Bundler + Paymaster) fuer gasfreie UserOperations. Chain "Ethereum Sepolia"
# im Dashboard aktivieren, Sponsorship-Policy aktiv.
VITE_PIMLICO_API_KEY=pimxxxx

# Contract-Adressen (Sepolia, siehe docs/DEPLOYMENT.md)
VITE_TOKEN_ADDRESS=0xHeidiFranc
VITE_VOUCHER_ADDRESS=0xHeidiVoucher

# Adresse der Park-"Kasse" (Backend-kontrolliert; Zahlungen + Rueckerstattungen)
VITE_PARK_TREASURY=0xParkTreasury
# Parktarif in HDI-Basiseinheiten (2 Dezimalst.) pro Minute. 5 = 0.05 HDI/min = 3 HDI/h
VITE_PARK_RATE_PER_MIN=5

# Basis-URL des Backends (Serverless). Default: "/api/heidi" (gleiche Domain).
# VITE_API_URL=

# Optional: zuverlaessiger Sepolia-RPC (Lesezugriffe). Default: publicnode
VITE_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com

# Optional: eigener Bundler/Paymaster-Proxy statt api.pimlico.io
# VITE_BUNDLER_URL=/api/pimlico

# Optional: Deploy-Block des Token -> schnellere Transaktions-Historie
# VITE_TOKEN_FROM_BLOCK=7000000


# ============ Backend (server/.env bzw. Vercel-Env OHNE VITE_) ============

RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
# EOA, die die Park-Kasse haelt (zahlt Rueckerstattungen) und Gutscheine erstellt.
PARK_TREASURY_PRIVATE_KEY=0xabc...
TOKEN_ADDRESS=0xHeidiFranc
VOUCHER_ADDRESS=0xHeidiVoucher
PARK_RATE_PER_MIN=5
# schuetzt /voucher/create
ADMIN_SECRET=change-me
# CORS: nur noetig fuer lokalen Server / andere Domain
CORS_ORIGIN=http://localhost:5174
PORT=8788
